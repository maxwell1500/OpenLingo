<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Back up local Room database, shared preferences, and state -->
        <include domain="database" path="duo_local.db" />
        <include domain="database" path="duo_local.db-wal" />
        <include domain="database" path="duo_local.db-shm" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="duo_local.db" />
        <include domain="database" path="duo_local.db-wal" />
        <include domain="database" path="duo_local.db-shm" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
